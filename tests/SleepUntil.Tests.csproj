<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BepInExCore Condition="'$(BepInExCore)' == ''">../tools/bepinex</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/SleepSchedule.cs" Link="SleepSchedule.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
